\documentclass[11pt,a4paper]{article}
\usepackage{notes}
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
$if(highlighting-macros)$
$highlighting-macros$
$endif$
$if(tables)$
\usepackage{longtable,booktabs,array,calc}
\usepackage{etoolbox}
\makeatletter
\patchcmd\longtable{\par}{\if@noskipsec\mbox{}\fi\par}{}{}
\makeatother
\newcounter{none}
$endif$
\usepackage{graphicx}
\makeatletter
\newsavebox\pandoc@box
\newcommand*\pandocbounded[1]{%
  \sbox\pandoc@box{#1}%
  \Gscale@div\@tempa{\textheight}{\dimexpr\ht\pandoc@box+\dp\pandoc@box\relax}%
  \Gscale@div\@tempb{\linewidth}{\wd\pandoc@box}%
  \ifdim\@tempb\p@<\@tempa\p@\let\@tempa\@tempb\fi
  \ifdim\@tempa\p@<\p@\scalebox{\@tempa}{\usebox\pandoc@box}%
  \else\usebox{\pandoc@box}%
  \fi}
\makeatother
$if(strikeout)$
\usepackage{soul}
$endif$

% метаданные конспекта (§4 ТЗ)
\course{$course$}
\coursename{$course_name$}
$if(lecture)$
\lecturenumber{$lecture$}
$endif$
$if(date)$
\lecturedate{$date$}
$endif$
\notestitle{$notes_title$}
\basis{$basis$}
\nbheaderline{$header_line$}
$if(is_forecast)$
\nbforecasttrue
$endif$
\hypersetup{pdftitle={$notes_title$}, pdfauthor={$program$}, pdflang={ru}}

\begin{document}
$if(based_on)$
\nbmaketitle{$notes_title$}{$based_on$}
$else$
\nbmaketitle{$notes_title$}{материалы курса}
$endif$

$body$

\end{document}
