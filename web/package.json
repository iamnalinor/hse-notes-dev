{
  "name": "hse-notes-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun scripts/spa-fallback.ts",
    "preview": "vite preview",
    "data:pull": "bun scripts/pull-data.ts",
    "lint": "bun run lint:format && bun run lint:eslint && bun run typecheck && bun run lint:knip && bun run lint:dup && bun run lint:arch",
    "lint:format": "biome format --write .",
    "lint:eslint": "eslint . --max-warnings 0 --cache --cache-location .cache/eslint/ --fix",
    "lint:knip": "knip --no-progress",
    "lint:dup": "jscpd",
    "lint:arch": "depcruise src scripts --config .dependency-cruiser.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "cd .. && lefthook install"
  },
  "dependencies": {
    "@floating-ui/react-dom": "2.1.9",
    "@tanstack/react-query": "5.104.3",
    "html-react-parser": "6.1.8",
    "katex": "0.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint-react/eslint-plugin": "5.24.4",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.3",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/eslint-plugin": "1.6.27",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-better-tailwindcss": "4.8.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "77.0.0",
    "jiti": "2.7.0",
    "jscpd": "5.4.0",
    "jsdom": "30.1.3",
    "knip": "6.39.0",
    "lefthook": "2.1.17",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
